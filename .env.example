# ── RESEND ───────────────────────────────────────────────────────────────────
# API key for transactional email (contact form + speaker booking)
# Get yours at https://resend.com/api-keys
RESEND_API_KEY=re_...

# ── ANALYTICS ────────────────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── CONTACT ──────────────────────────────────────────────────────────────────
# Destination email for contact form and speaker booking form submissions
NEXT_PUBLIC_CONTACT_EMAIL=your@email.com

# WhatsApp deep-link URL (include country code, no +, no spaces)
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/39XXXXXXXXXX

# ── SITE ─────────────────────────────────────────────────────────────────────
# Production domain — used in metadata and sitemap
NEXT_PUBLIC_SITE_URL=https://micheletornello.com
